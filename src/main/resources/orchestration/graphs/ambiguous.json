{
  "scenario": "ambiguous",
  "stages": [
    {
      "id": "req",
      "type": "REQUIREMENTS",
      "title": "Detect ambiguity in requirement",
      "dependsOn": [],
      "exitArtifacts": [
        "problemStatement",
        "impactAnalysis"
      ],
      "produces": [
        "requirementFingerprint",
        "normalizedProblem"
      ],
      "handler": "requirements"
    },
    {
      "id": "arch",
      "type": "ARCHITECTURE",
      "title": "Architecture for provisional scope",
      "dependsOn": [
        "req"
      ],
      "consumes": [
        "requirementFingerprint",
        "normalizedProblem"
      ],
      "exitContext": [
        "architectureReady"
      ],
      "exitArtifacts": [
        "architecture"
      ],
      "produces": [
        "architectureReady"
      ],
      "handler": "architecture"
    },
    {
      "id": "sec",
      "type": "SECURITY_REVIEW",
      "title": "Security & change-control review",
      "dependsOn": [
        "arch"
      ],
      "consumes": [
        "architectureReady"
      ],
      "entryContext": [
        "architectureReady"
      ],
      "exitContext": [
        "securityReviewPassed"
      ],
      "exitArtifacts": [
        "securityFindings"
      ],
      "produces": [
        "securityReviewPassed"
      ],
      "handler": "securityReview"
    },
    {
      "id": "impl",
      "type": "IMPLEMENTATION",
      "title": "Implement provisional scope",
      "dependsOn": [
        "sec"
      ],
      "requiresHumanApproval": true,
      "consumes": [
        "architectureReady",
        "securityReviewPassed"
      ],
      "entryContext": [
        "architectureReady",
        "securityReviewPassed"
      ],
      "exitContext": [
        "implementationDone"
      ],
      "exitArtifacts": [
        "changeArtifact",
        "agentValidation"
      ],
      "produces": [
        "implementationDone"
      ],
      "handler": "implementation"
    },
    {
      "id": "test",
      "type": "TESTING",
      "title": "Validate provisional scope",
      "dependsOn": [
        "impl"
      ],
      "fallbackStageId": "test_fallback",
      "consumes": [
        "implementationDone"
      ],
      "exitContext": [
        "testsPassed"
      ],
      "exitArtifacts": [
        "testReport",
        "passed"
      ],
      "produces": [
        "testsPassed"
      ],
      "handler": "testing"
    },
    {
      "id": "test_fallback",
      "type": "TESTING_FALLBACK",
      "title": "Fallback smoke tests",
      "dependsOn": [
        "impl"
      ],
      "activationOnly": true,
      "consumes": [
        "implementationDone"
      ],
      "exitContext": [
        "testsPassed"
      ],
      "exitArtifacts": [
        "testReport",
        "passed"
      ],
      "produces": [
        "testsPassed"
      ],
      "handler": "testingFallback"
    },
    {
      "id": "docs",
      "type": "DOCUMENTATION",
      "title": "Document provisional scope",
      "dependsOn": [
        "impl"
      ],
      "consumes": [
        "implementationDone"
      ],
      "exitContext": [
        "docsReady"
      ],
      "exitArtifacts": [
        "documentation"
      ],
      "produces": [
        "docsReady"
      ],
      "handler": "documentation"
    },
    {
      "id": "release",
      "type": "RELEASE_READINESS",
      "title": "Release readiness",
      "dependsOn": [
        "test",
        "docs"
      ],
      "requiresHumanApproval": true,
      "completesRun": true,
      "consumes": [
        "testsPassed",
        "docsReady"
      ],
      "entryContext": [
        "testsPassed",
        "docsReady"
      ],
      "exitArtifacts": [
        "releaseChecklist"
      ],
      "handler": "releaseReadiness"
    }
  ]
}
