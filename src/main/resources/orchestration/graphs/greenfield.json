{
  "scenario": "greenfield",
  "stages": [
    {
      "id": "req",
      "type": "REQUIREMENTS",
      "title": "Normalize greenfield requirement",
      "dependsOn": [],
      "exitArtifacts": ["problemStatement", "impactAnalysis"],
      "produces": ["requirementFingerprint", "normalizedProblem"]
    },
    {
      "id": "arch",
      "type": "ARCHITECTURE",
      "title": "Draft architecture",
      "dependsOn": ["req"],
      "consumes": ["requirementFingerprint", "normalizedProblem"],
      "exitContext": ["architectureReady"],
      "exitArtifacts": ["architecture"],
      "produces": ["architectureReady"]
    },
    {
      "id": "sec",
      "type": "SECURITY_REVIEW",
      "title": "Security & change-control review",
      "dependsOn": ["arch"],
      "consumes": ["architectureReady"],
      "entryContext": ["architectureReady"],
      "exitContext": ["securityReviewPassed"],
      "exitArtifacts": ["securityFindings"],
      "produces": ["securityReviewPassed"]
    },
    {
      "id": "impl",
      "type": "IMPLEMENTATION",
      "title": "Implement create+redirect+reliability APIs",
      "dependsOn": ["sec"],
      "requiresHumanApproval": true,
      "consumes": ["architectureReady", "securityReviewPassed"],
      "entryContext": ["architectureReady", "securityReviewPassed"],
      "exitContext": ["implementationDone"],
      "exitArtifacts": ["changeArtifact", "agentValidation"],
      "produces": ["implementationDone"]
    },
    {
      "id": "test",
      "type": "TESTING",
      "title": "Validate APIs (primary)",
      "dependsOn": ["impl"],
      "fallbackStageId": "test_fallback",
      "consumes": ["implementationDone"],
      "exitContext": ["testsPassed"],
      "exitArtifacts": ["testReport", "passed"],
      "produces": ["testsPassed"]
    },
    {
      "id": "test_fallback",
      "type": "TESTING_FALLBACK",
      "title": "Fallback reduced test pack",
      "dependsOn": ["impl"],
      "activationOnly": true,
      "consumes": ["implementationDone"],
      "exitContext": ["testsPassed"],
      "exitArtifacts": ["testReport", "passed"],
      "produces": ["testsPassed"]
    },
    {
      "id": "docs",
      "type": "DOCUMENTATION",
      "title": "Generate API docs",
      "dependsOn": ["impl"],
      "consumes": ["implementationDone"],
      "exitContext": ["docsReady"],
      "exitArtifacts": ["documentation"],
      "produces": ["docsReady"]
    },
    {
      "id": "release",
      "type": "RELEASE_READINESS",
      "title": "Release readiness gate",
      "dependsOn": ["test", "docs"],
      "requiresHumanApproval": true,
      "completesRun": true,
      "consumes": ["testsPassed", "docsReady"],
      "entryContext": ["testsPassed", "docsReady"],
      "exitArtifacts": ["releaseChecklist"]
    }
  ]
}
